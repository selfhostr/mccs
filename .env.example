# Copy to .env and adjust. Every variable is optional: empty = built-in default.
# Everything below except SUPPORT_* and PORT can also be changed later from the admin page
# (saved in the mccs-data volume, which takes precedence over this file).
# Apply with: docker compose up -d   (no rebuild needed)

# --- Docker -------------------------------------------------------------
HOST_PORT=8080
# IMAGE_NAME=mccs
# CONTAINER_NAME=mccs

# --- Branding -----------------------------------------------------------
BRAND_NAME=mccs
# Local path (/img/...) or absolute https URL; empty = text logo + neutral icon
BRAND_LOGO_URL=
# Accent colour, #rgb or #rrggbb; empty = ink blue (#8cbfe6 dark, #1f5f8b light)
BRAND_ACCENT=
# Page background: #rrggbb, a gradient "#rrggbb,#rrggbb", or an uploaded image /uploads/<file>
BRAND_BACKGROUND=

# --- Mail servers -------------------------------------------------------
MAIL_HOST=mail.example.com
IMAP_HOST=
# Defaults: 993, SSL/TLS (STARTTLS also accepted)
IMAP_PORT=
IMAP_SECURITY=
SMTP_HOST=
# Defaults: 465, SSL/TLS (STARTTLS also accepted)
SMTP_PORT=
SMTP_SECURITY=
# Defaults to https://$MAIL_HOST/
WEBMAIL_URL=
# Email domains accepted by the connection test, comma-separated; empty = all
ALLOWED_DOMAINS=

# --- Calendar and contacts (CalDAV / CardDAV) ---------------------------
# Usually left empty: the admin page detects the server (DNS SRV, /.well-known)
# and fills DAV_PRESET and the discovery URLs below.
# Server type: mdaemon (default) or generic (any standard CalDAV/CardDAV server)
DAV_PRESET=
# Defaults to https://$MAIL_HOST; set it if calendars live on another host
DAV_BASE_URL=
# Override individual URLs only if the detected ones do not fit.
# With generic, every calendar/contacts URL follows DAV_DISCOVERY_URL / DAV_CARD_DISCOVERY_URL.
# Templates accept {email}, {local} (part before @) and {domain}.
CALDAV_URL=
CARDDAV_URL=
TASKS_URL=
DAV_DISCOVERY_URL=
DAV_CARD_DISCOVERY_URL=
DAV_PRINCIPAL_URL_TEMPLATE=
DAV_CALENDAR_URL_TEMPLATE=
DAV_TASKS_URL_TEMPLATE=
DAV_CONTACTS_URL_TEMPLATE=

# --- Public address of this app (used in links and QR codes) ------------
PUBLIC_URL=https://config.example.com

# --- Support contact (all optional, hidden when empty) ------------------
# Any country format, e.g. +1 555 010 0100 or +44 20 7946 0958 ext. 12
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=
SUPPORT_ADDRESS=

# --- Admin area /support -------------------------------------------------
# Initial password; once changed in the admin, /data/admin.json wins (delete it to
# come back to this one). Empty and no admin.json = page disabled (404).
# Generate one: openssl rand -base64 24
SUPPORT_USER=support
SUPPORT_PASSWORD=
# Behind a reverse proxy: header carrying the client IP (CF-Connecting-IP or X-Forwarded-For)
TRUSTED_PROXY_HEADER=

# --- Apple configuration profile ----------------------------------------
# Defaults to BRAND_NAME
PROFILE_ORGANIZATION=
# Your own reverse-domain prefix; defaults to com.example.mailsetup
PROFILE_ID_PREFIX=
